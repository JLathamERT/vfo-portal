{
  "name": "vfo-react",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode staging",
    "dev:live": "vite",
    "build": "vite build && node scripts/emit-route-pages.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist --dotfiles",
    "build:staging": "vite build --mode staging && node scripts/emit-route-pages.mjs && node scripts/finish-staging-build.mjs",
    "deploy:staging": "npm run build:staging && gh-pages -d dist --dotfiles --repo https://github.com/JLathamERT/vfo-portal-staging.git"
  },
  "dependencies": {
    "@sentry/react": "^10.59.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "gh-pages": "^6.1.1",
    "vite": "^5.1.0"
  }
}
