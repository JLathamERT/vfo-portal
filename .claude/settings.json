{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|NotebookEdit|mcp__.*__deploy_edge_function",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/deploy-guard.mjs\"",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
